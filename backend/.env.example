# Copia este archivo como .env para trabajar en local (NO subas el .env a GitHub)

# Conexión a PostgreSQL.
# Supabase: Connect -> "Session pooler" (puerto 5432). Ejemplo:
#   postgresql://postgres.xxxxxxxx:TU_CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres
# (si la clave tiene símbolos como @ # / ?, hay que codificarlos: @ = %40, # = %23)
DATABASE_URL=postgresql://usuario:clave@localhost:5432/garantyapp

# Alternativa a DATABASE_URL (se usa solo si DATABASE_URL está vacía):
# DB_HOST=aws-0-REGION.pooler.supabase.com
# DB_USER=postgres.xxxxxxxx
# DB_PASSWORD=TU_CLAVE
# DB_NAME=postgres
# DB_PORT=5432

# Texto largo y aleatorio para firmar las sesiones
SESSION_SECRET=cambia-esto-por-un-texto-largo-y-secreto

# Dirección del frontend permitida por CORS (solo el origen, sin ruta ni "/" final)
# En GitHub Pages:  https://TU-USUARIO.github.io
FRONTEND_URL=http://localhost:5500

# En Render poner: production   (activa cookies Secure + SameSite=None)
NODE_ENV=development
